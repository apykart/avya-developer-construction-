        async function exportLeadsCSV() {
            const leads = await DB.getLeads();
            if (!leads.length) { showToast('No data to export.', 'error'); return; }
            const headers = ['Name','Phone','Email','Project','Status','Follow-up'];
            const rows = leads.map(l => [l.name, l.phone, l.email||'', l.project||'', l.status, l.followUp||'']);
            const csv = [headers.join(','), ...rows.map(r => r.map(v => `"${String(v).replace(/"/g,'""')}"`).join(','))].join('\n');
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a'); a.href = url; a.download = 'avya_leads_report.csv'; a.click();
            URL.revokeObjectURL(url);
            showToast('CSV exported!', 'success');
        }

