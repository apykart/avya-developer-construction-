<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AVYA Admin | Command Center</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="styles.css" />

    <script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-firestore-compat.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="firebase-config.js"></script>
    <script src="cloudinary-config.js"></script>
    <script src="db.js"></script>
</head>
<body>

    <!-- LOGIN SCREEN -->
    <div class="login-screen" id="loginScreen">
        <div class="login-box">
            <h2>AVYA<span style="color:var(--red);">.</span> ADMIN</h2>
            <div class="sub">Command Center — sign in to continue.</div>
            <form id="loginForm" novalidate>
                <div class="form-group"><label>Email</label><input type="email" id="loginEmail" placeholder="admin@yourcompany.com" required /></div>
                <div class="form-group"><label>Password</label><input type="password" id="loginPassword" placeholder="••••••••" required /></div>
                <div id="loginError" style="color:var(--red);font-size:0.8rem;margin-bottom:12px;display:none;"></div>
                <button type="submit" class="btn btn-primary w-full" style="justify-content:center;" id="loginBtn"><i class="fas fa-sign-in-alt"></i> Login</button>
            </form>
            <p style="font-size:0.75rem;color:var(--muted);margin-top:16px;">First time? Create the admin account once in Firebase Console → Authentication → Add user, then add a document at Firestore → <code>users/&lt;that uid&gt;</code> with field <code>role: "admin"</code>.</p>
        </div>
    </div>

    <!-- DASHBOARD -->
    <div class="dashboard-shell" id="dashboardShell" style="display:none;">
        <aside class="dash-sidebar">
            <div class="brand"><h3>AVYA<span class="red">.</span></h3><small>COMMAND CENTER</small></div>
            <div id="dashNavItems"></div>
            <div class="spacer"></div>
            <button class="logout-btn" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Logout</button>
        </aside>
        <main class="dash-main">
            <div class="header"><h2 id="dashTitle">Dashboard</h2><span class="badge-live"><i class="fas fa-circle" style="font-size:6px;"></i> LIVE</span></div>
            <div id="dashContent"></div>
        </main>
    </div>

    <div class="toast-container" id="toastContainer"></div>

    <script>
        // ============================================================
        // STATE
        // ============================================================
        let currentView = 'dashboard';
        let charts = {};
        let cachedManagers = [];
        let cachedProjects = [];

        function showToast(message, type = 'info', duration = 4000) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'toast ' + type;
            const icons = { success: 'fa-check-circle', error: 'fa-exclamation-circle', info: 'fa-info-circle' };
            toast.innerHTML = `<i class="fas ${icons[type] || icons.info}"></i> ${message}`;
            container.appendChild(toast);
            setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300); }, duration);
        }
        function fmtDate(ts) { if (!ts) return '—'; if (ts.seconds) return new Date(ts.seconds * 1000).toLocaleDateString(); return ts; }
        function badgeClass(status) { return 'badge-' + String(status || '').replace(/\s+/g, '-').toLowerCase(); }

        // ============================================================
        // AUTH
        // ============================================================
        document.getElementById('loginForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = document.getElementById('loginBtn');
            const errBox = document.getElementById('loginError');
            errBox.style.display = 'none';
            btn.disabled = true; btn.innerHTML = '<span class="spinner"></span> Signing in…';
            try {
                const email = document.getElementById('loginEmail').value.trim();
                const pass = document.getElementById('loginPassword').value;
                const cred = await auth.signInWithEmailAndPassword(email, pass);
                const roleDoc = await DB.getUserRole(cred.user.uid);
                if (!roleDoc || roleDoc.role !== 'admin') {
                    await auth.signOut();
                    errBox.textContent = 'This login is not registered as an Admin.';
                    errBox.style.display = 'block';
                }
                // onAuthStateChanged below handles showing the dashboard
            } catch (err) {
                errBox.textContent = err.message.replace('Firebase: ', '');
                errBox.style.display = 'block';
            } finally { btn.disabled = false; btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Login'; }
        });

        auth.onAuthStateChanged(async (user) => {
            if (!user) { document.getElementById('loginScreen').style.display = 'flex'; document.getElementById('dashboardShell').style.display = 'none'; return; }
            const roleDoc = await DB.getUserRole(user.uid);
            if (!roleDoc || roleDoc.role !== 'admin') { document.getElementById('loginScreen').style.display = 'flex'; document.getElementById('dashboardShell').style.display = 'none'; return; }
            document.getElementById('loginScreen').style.display = 'none';
            document.getElementById('dashboardShell').style.display = 'flex';
            renderNav();
            navigateTo('dashboard');
        });

        function logout() {
            if (!confirm('Logout from Admin?')) return;
            auth.signOut();
        }

        // ============================================================
        // NAV
        // ============================================================
        function renderNav() {
            const items = [
                { id: 'dashboard', label: 'Dashboard', icon: 'fa-chart-pie' },
                { id: 'enquiries', label: 'Enquiries', icon: 'fa-inbox' },
                { id: 'leads', label: 'Leads', icon: 'fa-user-plus' },
                { id: 'customers', label: 'Customers', icon: 'fa-user-check' },
                { id: 'projects', label: 'Projects', icon: 'fa-building' },
                { id: 'gallery', label: 'Gallery', icon: 'fa-images' },
                { id: 'testimonials', label: 'Testimonials', icon: 'fa-quote-right' },
                { id: 'managers', label: 'Associates', icon: 'fa-users' },
                { id: 'sitevisits', label: 'Site Visits', icon: 'fa-calendar-check' },
                { id: 'followups', label: 'Follow-Ups', icon: 'fa-bell' },
                { id: 'reports', label: 'Reports', icon: 'fa-chart-bar' },
                { id: 'settings', label: 'Settings', icon: 'fa-cog' }
            ];
            document.getElementById('dashNavItems').innerHTML = items.map(i => `
                <div class="nav-item ${currentView===i.id?'active':''}" data-view="${i.id}"><i class="fas ${i.icon}"></i><span>${i.label}</span></div>`).join('');
            document.querySelectorAll('#dashNavItems .nav-item').forEach(el => el.addEventListener('click', () => navigateTo(el.dataset.view)));
        }
        function navigateTo(view) {
            currentView = view;
            document.querySelectorAll('#dashNavItems .nav-item').forEach(el => el.classList.toggle('active', el.dataset.view === view));
            document.getElementById('dashTitle').textContent = view.charAt(0).toUpperCase() + view.slice(1);
            renderView(view);
        }
        function renderView(view) {
            const c = document.getElementById('dashContent');
            c.innerHTML = '<p style="color:var(--muted);padding:20px 0;"><span class="spinner dark"></span> Loading…</p>';
            const map = { dashboard: renderDashboard, enquiries: renderEnquiriesView, leads: renderLeadsView, customers: renderCustomersView,
                projects: renderProjectsView, gallery: renderGalleryView, testimonials: renderTestimonialsView, managers: renderManagersView,
                sitevisits: renderSiteVisitsView, followups: renderFollowUpsView, reports: renderReportsView, settings: renderSettingsView };
            (map[view] || (() => { c.innerHTML = '<p>View not found.</p>'; }))(c);
        }

        // ============================================================
        // DASHBOARD
        // ============================================================
        async function renderDashboard(c) {
            const [leads, visits, customers, followups, managers, enquiries] = await Promise.all([
                DB.getLeads(), DB.getSiteVisits(), DB.getCustomers(), DB.getFollowUps(), DB.getManagers(), DB.getEnquiries()
            ]);
            cachedManagers = managers;
            const newLeads = leads.filter(l => l.status === 'new').length;
            const activeManagers = managers.filter(m => m.status === 'active').length;
            const pendingFollowups = followups.filter(f => f.status === 'pending').length;

            c.innerHTML = `
                <div class="dash-stats">
                    <div class="dash-stat"><div class="num">${enquiries.length}</div><div class="label">Enquiries</div></div>
                    <div class="dash-stat"><div class="num">${leads.length}</div><div class="label">Total Leads</div></div>
                    <div class="dash-stat"><div class="num">${newLeads}</div><div class="label">New Leads</div></div>
                    <div class="dash-stat"><div class="num">${visits.length}</div><div class="label">Site Visits</div></div>
                    <div class="dash-stat"><div class="num">${customers.length}</div><div class="label">Customers</div></div>
                    <div class="dash-stat"><div class="num">${activeManagers}</div><div class="label">Active Associates</div></div>
                    <div class="dash-stat"><div class="num">${pendingFollowups}</div><div class="label">Pending Follow-ups</div></div>
                </div>
                <div class="dash-charts" style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:32px;">
                    <div class="dash-chart" style="background:var(--white);padding:20px;border-radius:var(--radius);border:1px solid rgba(0,0,0,0.03);"><h4 style="font-size:0.85rem;font-weight:700;margin-bottom:12px;">Leads by Status</h4><canvas id="chartStatus"></canvas></div>
                    <div class="dash-chart" style="background:var(--white);padding:20px;border-radius:var(--radius);border:1px solid rgba(0,0,0,0.03);"><h4 style="font-size:0.85rem;font-weight:700;margin-bottom:12px;">Leads per Associate</h4><canvas id="chartManagers"></canvas></div>
                </div>
                <h4 style="margin:12px 0 8px;font-weight:700;">Recent Enquiries</h4>
                <div class="dash-table-wrap"><table><thead><tr><th>Name</th><th>Phone</th><th>Project</th><th>Date</th></tr></thead>
                <tbody>${enquiries.slice(0,6).map(e => `<tr><td>${e.name}</td><td>${e.phone}</td><td>${e.project||'—'}</td><td>${fmtDate(e.createdAt)}</td></tr>`).join('') || '<tr><td colspan="4" style="text-align:center;color:var(--muted);padding:20px;">No enquiries yet.</td></tr>'}</tbody></table></div>
            `;
            setTimeout(() => {
                const statuses = ['new','contacted','interested','site visit scheduled','visited','negotiation','booked','lost'];
                const counts = statuses.map(s => leads.filter(l => l.status === s).length);
                Object.values(charts).forEach(ch => ch && ch.destroy()); charts = {};
                const ctx1 = document.getElementById('chartStatus');
                if (ctx1) charts.status = new Chart(ctx1, { type: 'doughnut', data: { labels: statuses, datasets: [{ data: counts, backgroundColor: ['#3b82f6','#f59e0b','#10b981','#8b5cf6','#06b6d4','#f97316','#22c55e','#ef4444'] }] }, options: { plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 9 } } } } } });
                const ctx2 = document.getElementById('chartManagers');
                if (ctx2) charts.managers = new Chart(ctx2, { type: 'bar', data: { labels: managers.map(m => m.fullName), datasets: [{ label: 'Leads', data: managers.map(m => leads.filter(l => l.managerId === m.id).length), backgroundColor: '#B5121B', borderRadius: 4 }] }, options: { plugins: { legend: { display: false } } } });
            }, 50);
        }

        // ============================================================
        // ENQUIRIES
        // ============================================================
        async function renderEnquiriesView(c) {
            const enquiries = await DB.getEnquiries();
            c.innerHTML = `
                <div class="dash-table-wrap"><table><thead><tr><th>Name</th><th>Phone</th><th>Project</th><th>Budget</th><th>Message</th><th>Received</th><th></th></tr></thead>
                <tbody>${enquiries.map(e => `<tr><td><strong>${e.name}</strong></td><td>${e.phone}</td><td>${e.project||'—'}</td><td>${e.budget||'—'}</td><td style="max-width:200px;">${(e.message||'').slice(0,60)}</td><td>${fmtDate(e.createdAt)}</td>
                <td><button class="btn btn-sm btn-primary" onclick='convertEnquiryToLead(${JSON.stringify(e).replace(/'/g,"&apos;")})'>→ Lead</button></td></tr>`).join('') || '<tr><td colspan="7" style="text-align:center;color:var(--muted);padding:30px;">No enquiries yet.</td></tr>'}</tbody></table></div>`;
        }
        async function convertEnquiryToLead(e) {
            await DB.addLead({ name: e.name, phone: e.phone, email: e.email||'', project: e.project||'', propertyType: e.type||'', budget: e.budget||'', status: 'new', notes: e.message||'', followUp: '', managerId: '' });
            showToast('Converted to lead!', 'success');
            navigateTo('leads');
        }

        // ============================================================
        // LEADS
        // ============================================================
        async function renderLeadsView(c) {
            const [leads, managers] = await Promise.all([DB.getLeads(), DB.getManagers()]);
            cachedManagers = managers;
            window.__leads = leads;
            c.innerHTML = `
                <div class="dash-actions"><button class="btn btn-primary" onclick="showAddLead()"><i class="fas fa-plus"></i> Add Lead</button></div>
                <div class="dash-search"><input type="text" id="leadSearch" placeholder="Search leads..." oninput="filterLeadsTable()" />
                <select id="leadStatusFilter" onchange="filterLeadsTable()"><option value="all">All Status</option><option value="new">New</option><option value="contacted">Contacted</option><option value="interested">Interested</option><option value="site visit scheduled">Scheduled</option><option value="visited">Visited</option><option value="negotiation">Negotiation</option><option value="booked">Booked</option><option value="lost">Lost</option></select></div>
                <div class="dash-table-wrap"><table><thead><tr><th>Name</th><th>Phone</th><th>Project</th><th>Status</th><th>Associate</th><th>Follow-up</th><th>Actions</th></tr></thead><tbody id="leadsTbody"></tbody></table></div>`;
            filterLeadsTable();
        }
        function filterLeadsTable() {
            const leads = window.__leads || [];
            const search = (document.getElementById('leadSearch')?.value || '').toLowerCase();
            const status = document.getElementById('leadStatusFilter')?.value || 'all';
            const filtered = leads.filter(l => (l.name.toLowerCase().includes(search) || l.phone.includes(search)) && (status === 'all' || l.status === status));
            document.getElementById('leadsTbody').innerHTML = filtered.map(l => {
                const mgr = cachedManagers.find(m => m.id === l.managerId);
                return `<tr><td><strong>${l.name}</strong></td><td>${l.phone}</td><td>${l.project||'—'}</td><td><span class="badge ${badgeClass(l.status)}">${l.status}</span></td><td>${mgr?mgr.fullName:'—'}</td><td>${l.followUp||'—'}</td>
                <td><button class="btn btn-sm btn-outline-dark" onclick="editLead('${l.id}')"><i class="fas fa-edit"></i></button> <button class="btn btn-sm btn-outline-dark" onclick="deleteLead('${l.id}')"><i class="fas fa-trash"></i></button></td></tr>`;
            }).join('') || '<tr><td colspan="7" style="text-align:center;color:var(--muted);padding:30px;">No leads found.</td></tr>';
        }
        function leadFormFields(l = {}) {
            const mgrOptions = cachedManagers.map(m => `<option value="${m.id}" ${l.managerId===m.id?'selected':''}>${m.fullName}</option>`).join('');
            const projOptions = cachedProjects.map(p => `<option value="${p.name}" ${l.project===p.name?'selected':''}>${p.name}</option>`).join('');
            return `
                <div class="form-group"><label>Name *</label><input type="text" id="lName" value="${l.name||''}" required /></div>
                <div class="form-group"><label>Phone *</label><input type="tel" id="lPhone" value="${l.phone||''}" required /></div>
                <div class="form-group"><label>Email</label><input type="email" id="lEmail" value="${l.email||''}" /></div>
                <div class="form-group"><label>Project</label><select id="lProject"><option value="">Select</option>${projOptions}</select></div>
                <div class="form-group"><label>Property Type</label><select id="lType"><option value="">Select</option><option value="residential" ${l.propertyType==='residential'?'selected':''}>Residential</option><option value="commercial" ${l.propertyType==='commercial'?'selected':''}>Commercial</option><option value="villa" ${l.propertyType==='villa'?'selected':''}>Villa</option><option value="farmhouse" ${l.propertyType==='farmhouse'?'selected':''}>Farm House</option></select></div>
                <div class="form-group"><label>Budget</label><select id="lBudget"><option value="">Select</option><option value="10-25" ${l.budget==='10-25'?'selected':''}>₹10L–25L</option><option value="25-50" ${l.budget==='25-50'?'selected':''}>₹25L–50L</option><option value="50-100" ${l.budget==='50-100'?'selected':''}>₹50L–1Cr</option><option value="100+" ${l.budget==='100+'?'selected':''}>₹1Cr+</option></select></div>
                <div class="form-group"><label>Assign Associate</label><select id="lManager"><option value="">Unassigned</option>${mgrOptions}</select></div>
                <div class="form-group full"><label>Status</label><select id="lStatus"><option value="new" ${l.status==='new'?'selected':''}>New</option><option value="contacted" ${l.status==='contacted'?'selected':''}>Contacted</option><option value="interested" ${l.status==='interested'?'selected':''}>Interested</option><option value="site visit scheduled" ${l.status==='site visit scheduled'?'selected':''}>Site Visit Scheduled</option><option value="visited" ${l.status==='visited'?'selected':''}>Visited</option><option value="negotiation" ${l.status==='negotiation'?'selected':''}>Negotiation</option><option value="booked" ${l.status==='booked'?'selected':''}>Booked</option><option value="lost" ${l.status==='lost'?'selected':''}>Lost</option></select></div>
                <div class="form-group full"><label>Next Follow-up</label><input type="date" id="lFollowUp" value="${l.followUp||''}" /></div>
                <div class="form-group full"><label>Notes</label><textarea id="lNotes" rows="2">${l.notes||''}</textarea></div>`;
        }
        function showAddLead() {
            document.getElementById('dashContent').innerHTML = `<h3 style="margin-bottom:16px;">Add New Lead</h3><form id="leadForm" class="form-2col" style="max-width:700px;">${leadFormFields()}
                <div class="form-group full" style="display:flex;gap:12px;flex-wrap:wrap;"><button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Lead</button><button type="button" class="btn btn-outline-dark" onclick="navigateTo('leads')">Cancel</button></div></form>`;
            document.getElementById('leadForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                const phone = document.getElementById('lPhone').value.replace(/\D/g, '');
                if (phone.length !== 10) { showToast('Enter a valid 10-digit phone number.', 'error'); return; }
                await DB.addLead({ name: document.getElementById('lName').value.trim(), phone, email: document.getElementById('lEmail').value.trim(),
                    project: document.getElementById('lProject').value, propertyType: document.getElementById('lType').value, budget: document.getElementById('lBudget').value,
                    managerId: document.getElementById('lManager').value, status: document.getElementById('lStatus').value, followUp: document.getElementById('lFollowUp').value, notes: document.getElementById('lNotes').value.trim() });
                showToast('Lead added!', 'success'); navigateTo('leads');
            });
        }
        async function editLead(id) {
            const l = (window.__leads || []).find(x => x.id === id);
            if (!l) return;
            document.getElementById('dashContent').innerHTML = `<h3 style="margin-bottom:16px;">Edit Lead</h3><form id="leadForm" class="form-2col" style="max-width:700px;">${leadFormFields(l)}
                <div class="form-group full" style="display:flex;gap:12px;flex-wrap:wrap;"><button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Update Lead</button><button type="button" class="btn btn-outline-dark" onclick="navigateTo('leads')">Cancel</button></div></form>`;
            document.getElementById('leadForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                const phone = document.getElementById('lPhone').value.replace(/\D/g, '');
                if (phone.length !== 10) { showToast('Enter a valid 10-digit phone number.', 'error'); return; }
                await DB.updateLead(id, { name: document.getElementById('lName').value.trim(), phone, email: document.getElementById('lEmail').value.trim(),
                    project: document.getElementById('lProject').value, propertyType: document.getElementById('lType').value, budget: document.getElementById('lBudget').value,
                    managerId: document.getElementById('lManager').value, status: document.getElementById('lStatus').value, followUp: document.getElementById('lFollowUp').value, notes: document.getElementById('lNotes').value.trim() });
                showToast('Lead updated!', 'success'); navigateTo('leads');
            });
        }
        async function deleteLead(id) { if (!confirm('Delete this lead?')) return; await DB.deleteLead(id); showToast('Lead deleted.', 'info'); navigateTo('leads'); }

        // ============================================================
        // CUSTOMERS
        // ============================================================
        async function renderCustomersView(c) {
            const [customers, managers] = await Promise.all([DB.getCustomers(), DB.getManagers()]);
            cachedManagers = managers;
            c.innerHTML = `<div class="dash-table-wrap"><table><thead><tr><th>Name</th><th>Phone</th><th>Project</th><th>Status</th><th>Associate</th></tr></thead>
                <tbody>${customers.map(cu => { const mgr = managers.find(m => m.id === cu.managerId); return `<tr><td><strong>${cu.name}</strong></td><td>${cu.phone}</td><td>${cu.project||'—'}</td><td><span class="badge ${badgeClass(cu.status)}">${cu.status}</span></td><td>${mgr?mgr.fullName:'—'}</td></tr>`; }).join('') || '<tr><td colspan="5" style="text-align:center;color:var(--muted);padding:30px;">No customers yet.</td></tr>'}</tbody></table></div>`;
        }

        // ============================================================
        // PROJECTS (with Cloudinary image upload)
        // ============================================================
        async function renderProjectsView(c) {
            const projects = await DB.getProjects();
            cachedProjects = projects;
            c.innerHTML = `<div class="dash-actions"><button class="btn btn-primary" onclick="showAddProject()"><i class="fas fa-plus"></i> Add Project</button></div>
                <div class="dash-table-wrap"><table><thead><tr><th>Image</th><th>Name</th><th>Location</th><th>Category</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>${projects.map(p => `<tr><td><img src="${p.img}" style="width:56px;height:40px;object-fit:cover;border-radius:4px;" /></td><td><strong>${p.name}</strong></td><td>${p.location}</td><td>${p.category}</td><td><span class="badge ${badgeClass(p.status)}">${p.status}</span></td>
                <td><button class="btn btn-sm btn-outline-dark" onclick="editProject('${p.id}')"><i class="fas fa-edit"></i></button> <button class="btn btn-sm btn-outline-dark" onclick="deleteProjectRow('${p.id}')"><i class="fas fa-trash"></i></button></td></tr>`).join('') || '<tr><td colspan="6" style="text-align:center;color:var(--muted);padding:30px;">No projects yet.</td></tr>'}</tbody></table></div>`;
        }
        function projectFormFields(p = {}) {
            return `
                <div class="form-group full"><label>Project Image</label>
                    <div class="upload-box" id="projImgBox" onclick="document.getElementById('projImgInput').click()">
                        ${p.img ? `<img src="${p.img}" id="projImgPreview" />` : `<img src="" id="projImgPreview" style="display:none;" />`}
                        <div id="projImgHint"><i class="fas fa-cloud-upload-alt"></i> Click to upload image</div>
                    </div>
                    <input type="file" id="projImgInput" accept="image/*" style="display:none;" />
                    <input type="hidden" id="projImgUrl" value="${p.img||''}" />
                </div>
                <div class="form-group"><label>Name *</label><input type="text" id="pName" value="${p.name||''}" required /></div>
                <div class="form-group"><label>Location *</label><input type="text" id="pLocation" value="${p.location||''}" required /></div>
